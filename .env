# Development environment configuration for Tourist Safety Frontend

# Backend API URL - For local development
REACT_APP_API_URL=https://tourist-backend-raud.onrender.com

# WebSocket URL - For local development
REACT_APP_WS_URL=https://tourist-backend-raud.onrender.com

# Application settings
REACT_APP_APP_NAME=Tourist Safety Monitor (Dev)
REACT_APP_VERSION=1.0.0-dev

# Map configuration
REACT_APP_DEFAULT_LAT=26.2006
REACT_APP_DEFAULT_LNG=92.9376
REACT_APP_DEFAULT_ZOOM=7

# Feature flags
REACT_APP_ENABLE_WEBSOCKET=true
REACT_APP_ENABLE_GEOFENCING=true
REACT_APP_DEMO_MODE=true